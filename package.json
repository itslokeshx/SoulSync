{
  "name": "soulsync",
  "private": true,
  "version": "5.1.2",
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,emerald\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck"
  },
  "dependencies": {
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
